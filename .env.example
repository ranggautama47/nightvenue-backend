# NightVenue Backend Environment Template
# Copy this file to .env and fill in required secrets locally:
# PowerShell: Copy-Item .env.example .env
SPRING_PROFILES_ACTIVE=dev
APP_CORS_ALLOWED_ORIGINS=

# Database (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/nightvenue
SPRING_DATASOURCE_USERNAME=nightvenue
SPRING_DATASOURCE_PASSWORD=

# Cache / Ephemeral Store (Redis)
REDIS_URL=redis://redis:6379

# Internal ML Service (FastAPI)
ML_SERVICE_URL=http://ml-service:8000
ML_INTERNAL_TOKEN=

# Authentication
JWT_SECRET=
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
AUTH_COOKIE_SECURE=false
# Default: trust loopback only. In production set this explicitly to your real proxy's
# internal address range (e.g. 10[.][0-9]+[.][0-9]+[.][0-9]+). Never trust all private ranges blindly.
APP_TRUSTED_PROXIES=127[.][0-9]+[.][0-9]+[.][0-9]+|::1|0:0:0:0:0:0:0:1

# Authentication rate limits (requests per period)
AUTH_RATE_LIMIT_LOGIN=5
AUTH_RATE_LIMIT_LOGIN_PERIOD=PT1M
AUTH_RATE_LIMIT_REFRESH=10
AUTH_RATE_LIMIT_REFRESH_PERIOD=PT1M
AUTH_RATE_LIMIT_LOGOUT=20
AUTH_RATE_LIMIT_LOGOUT_PERIOD=PT1M
AUTH_RATE_LIMIT_ME=30
AUTH_RATE_LIMIT_ME_PERIOD=PT1M
NIGHTVENUE_OPENAPI_PUBLIC=false

# Synthetic demo seed (dev-only; set to true if you want sample venues, users, and 90-day ledger)
NIGHTVENUE_SEED_ENABLED=false

# Payment Gateway (Phase 6+)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
