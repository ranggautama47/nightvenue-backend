# NightVenue Backend Environment Template
# Copy this file to the repository root as .env and fill secrets locally.
# Bash: cp .env.example .env
# PowerShell: Copy-Item .env.example .env
# Never commit .env or share its contents.

# Runtime
SPRING_PROFILES_ACTIVE=dev
APP_CORS_ALLOWED_ORIGINS=

# Database (Docker Compose network)
# For API launched on the host, use the host-mapped PostgreSQL port instead.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/nightvenue
SPRING_DATASOURCE_USERNAME=nightvenue
SPRING_DATASOURCE_PASSWORD=

# Cache / Ephemeral Store (Redis)
REDIS_URL=redis://redis:6379
NIGHTVENUE_CACHE_MENU_TTL=PT5M

# Internal ML Service (FastAPI)
ML_SERVICE_URL=http://ml-service:8000
ML_INTERNAL_TOKEN=

# Authentication and security
JWT_SECRET=
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
# false is for local development only. Set true in production behind HTTPS.
AUTH_COOKIE_SECURE=false
# Trust loopback only by default. In production, configure the actual trusted proxy range.
APP_TRUSTED_PROXIES=127[.][0-9]+[.][0-9]+[.][0-9]+|::1|0:0:0:0:0:0:0:1

# Authentication rate limits
AUTH_RATE_LIMIT_LOGIN=5
AUTH_RATE_LIMIT_LOGIN_PERIOD=PT1M
AUTH_RATE_LIMIT_REFRESH=10
AUTH_RATE_LIMIT_REFRESH_PERIOD=PT1M
AUTH_RATE_LIMIT_LOGOUT=20
AUTH_RATE_LIMIT_LOGOUT_PERIOD=PT1M
AUTH_RATE_LIMIT_ME=30
AUTH_RATE_LIMIT_ME_PERIOD=PT1M

# Application features
NIGHTVENUE_OPENAPI_PUBLIC=false
NIGHTVENUE_SEED_ENABLED=false

# ==========================================
# Payment Provider — Xendit (Exclusive for new QRIS)
# M3-B adapter and Spring property binding must exist before activation.
# ==========================================
XENDIT_SECRET_KEY=
XENDIT_API_VERSION=2024-11-11
XENDIT_BASE_URL=https://api.xendit.co

# M4 webhook configuration — validate this callback token before processing any event.
# XENDIT_CALLBACK_TOKEN=

# ==========================================
# Legacy Midtrans (DEPRECATED)
# Retained ONLY for historical data reconciliation. 
# Will be removed in a future cleanup phase after outstanding payments are drained.
# ==========================================
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
