# Normalize text files to LF; keep Windows command scripts CRLF.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Force LF on shell scripts, maven wrapper, dockerfiles and workflow YAMLs (prevent Windows CRLF container breakage)
mvnw text eol=lf
*.sh text eol=lf
Dockerfile* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
